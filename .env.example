# All variables are optional; the defaults below are used when unset.
# The schema (with validation) lives in src/config.ts.

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- HTTP hardening ---------------------------------------------------------------------
# Comma-separated list of allowed origins, e.g. https://app.example.com
CORS_ORIGINS=*
# Use X-Forwarded-For as the client IP. Enable ONLY behind a trusted reverse proxy.
TRUST_PROXY=false
# Token bucket per client IP: burst size and sustained refill rate (requests/second).
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1

# --- GraphQL hardening ------------------------------------------------------------------
# Defaults to false when NODE_ENV=production, true otherwise.
# GRAPHQL_INTROSPECTION=false
MAX_QUERY_DEPTH=8
MAX_QUERY_COST=1500
# JSON allow-list { "<sha256>": "<query>" } for persisted operations.
# PERSISTED_OPERATIONS_FILE=./persisted-operations.json
# Reject any document that is not in the allow-list.
PERSISTED_OPERATIONS_ONLY=false

# --- Upstream HTTP client ---------------------------------------------------------------
HTTP_TIMEOUT_MS=5000
HTTP_RETRIES=2
HTTP_RETRY_BASE_DELAY_MS=150

# --- Cache (in-memory LRU, values in ms) ------------------------------------------------
# Every entry is additionally served stale for one extra TTL while revalidating.
CACHE_MAX_ENTRIES=5000
# 24h
CACHE_TTL_COUNTRIES_MS=86400000
# 7d
CACHE_TTL_GEOCODING_MS=604800000
# 10m
CACHE_TTL_WEATHER_MS=600000
# 1h
CACHE_TTL_FX_MS=3600000

# --- Upstreams (key-less public APIs) ---------------------------------------------------
COUNTRIES_DATASET_URL=https://cdn.jsdelivr.net/gh/mledoze/countries@5.1.0/countries.json
OPEN_METEO_URL=https://api.open-meteo.com/v1
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
FRANKFURTER_URL=https://api.frankfurter.dev/v2

SHUTDOWN_TIMEOUT_MS=10000
